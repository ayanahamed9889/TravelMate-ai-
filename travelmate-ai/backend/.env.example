# ---- Database ----
# SQLite (default, zero setup). For PostgreSQL use e.g.
# DATABASE_URL=postgresql://travelmate:travelmate123@localhost:5432/travelmate
DATABASE_URL=sqlite:///./travelmate.db

# ---- Auth ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- AI (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey  - NEVER commit a real key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Falls back automatically to older models if this one is unavailable
LLM_MODEL=gemini-3.7-flash
# true  = always use built-in sample itineraries/chat (no key needed)
FORCE_DEMO_MODE=false

# ---- Optional real-data APIs ----
GEOAPIFY_API_KEY=        # live hotel search (free tier)
FOURSQUARE_API_KEY=      # restaurants (falls back to OpenStreetMap)
PEXELS_API_KEY=          # real hotel photos (free key: https://www.pexels.com/api/). Without it hotels show an area photo

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
